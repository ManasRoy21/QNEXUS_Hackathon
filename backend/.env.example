# QDS Threat Detection Backend Environment Variables
ENVIRONMENT=production
PROJECT_NAME="QDS Threat Detection"
API_V1_STR=/api/v1
# Optional: 64 hex characters encoding a private random 32-byte Ed25519 seed.
# Keep private. Omit for an ephemeral key lasting one API process.
# IMAGE_LAB_SIGNING_KEY=
# Optional writable SQLite path. Run one API process for the local worker.
# QDS_DATABASE_PATH=/absolute/path/qds.sqlite3

# Comma-separated list of allowed origins for CORS.
# For Vercel deployments, configure your frontend production URL and preview regex:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.vercel.app
