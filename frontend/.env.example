# QDS Threat Detection Frontend Environment Variables
# In production on Vercel, set this to your backend service URL (e.g. https://<backend-project>.vercel.app/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional WebSocket URL (if using external WebSocket server for streaming telemetry)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
