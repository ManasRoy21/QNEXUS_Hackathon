*.pyo
*.pyd
*.class
*.o
*.a
*.lib
*.dll
*.dylib
*.tsbuildinfo


# ── Logs ─────────────────────────────────────────────────────────
logs/
*.log
*.log.*
pip-log.txt
pip-delete-this-directory.txt

# ── OS artifacts ─────────────────────────────────────────────────
